[Unit]
Description=RoboCup car-drone competition mission listener
RequiresMountsFor=/home/radxa/car

[Service]
Type=simple
User=radxa
Group=radxa
SupplementaryGroups=dialout
WorkingDirectory=/home/radxa/car
RuntimeDirectory=robocup-car
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/python3 /home/radxa/car/tools/setup_payload_pwm_permissions.py
ExecStartPre=/usr/bin/test -x /home/radxa/robocup_ros/vision_env/bin/python
ExecStartPre=/usr/bin/test -x /home/radxa/robocup_ros/bin/micromamba
ExecStart=/home/radxa/robocup_ros/bin/micromamba run -p /home/radxa/robocup_ros/env /home/radxa/robocup_ros/vision_env/bin/python /home/radxa/car/code/competition_boot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
Environment=MAMBA_ROOT_PREFIX=/home/radxa/robocup_ros/root
Environment=PYTHONPATH=/home/radxa/robocup_ros/python_ext:/home/radxa/car/code
SyslogIdentifier=car-competition-boot
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=60

[Install]
WantedBy=multi-user.target
