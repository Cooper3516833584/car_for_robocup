[Unit]
Description=RoboCup HC-15 competition listener
After=network.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/car
# Check the existing ROS environment, GPIO/PWM access and noninteractive
# permission to restart robocup-slam.service before installing this template.
ExecStart=/home/radxa/robocup_ros/env/bin/python -u /home/radxa/car/code/competition_boot.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=40
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
