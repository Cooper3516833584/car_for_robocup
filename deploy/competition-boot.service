[Unit]
Description=RoboCup car-only full-flow test listener (no drone or payload output)
RequiresMountsFor=/home/radxa/car

[Service]
Type=simple
User=radxa
Group=radxa
SupplementaryGroups=dialout
WorkingDirectory=/home/radxa/car
ExecStartPre=/usr/bin/test -x /home/radxa/robocup_ros/env/bin/python
ExecStart=/home/radxa/robocup_ros/env/bin/python /home/radxa/car/code/car_full_flow_test.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
SyslogIdentifier=car-competition-boot
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=60

[Install]
WantedBy=multi-user.target
