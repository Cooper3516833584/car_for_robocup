[Unit]
Description=RoboCup unique slam_toolbox sidecar (fresh instance per RUN)
After=network.target

[Service]
Type=simple
User=radxa
WorkingDirectory=/home/radxa/car
# Loopback multicast has to be enabled before the ROS participant is created:
# 127.0.0.1 is the only transport this unit uses (ROS_LOCALHOST_ONLY below), and
# without IFF_MULTICAST on lo the bridge and this node cannot discover each other.
ExecStartPre=+/usr/bin/ip link set dev lo multicast on
Environment=ROS_LOCALHOST_ONLY=1
Environment=MAMBA_ROOT_PREFIX=/home/radxa/robocup_ros/root
ExecStartPre=/usr/bin/test -x /home/radxa/robocup_ros/bin/micromamba
ExecStartPre=/usr/bin/test -x /home/radxa/robocup_ros/env/bin/ros2
ExecStart=/home/radxa/robocup_ros/bin/micromamba run -p /home/radxa/robocup_ros/env ros2 launch /home/radxa/car/launch/robocup_slam.launch.py
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=multi-user.target
